  "content_limits": {
    "title_max_lines": 2,
    "subtitle_max_lines": 2,
    "card_title_max_lines": 2,
    "card_body_max_lines": 4,
    "footer_summary_max_lines": 2,
    "two_card_max_chars_per_card": 150,
    "three_card_max_chars_per_card": 100,
    "four_card_max_chars_per_card": 72,
    "five_card_max_chars_per_card": 54,
    "twelve_step_max_chars_per_card": 22,
    "filename_max_chars": 26
  },
  "overflow_policy": {
    "strategy": "split_slide",
    "never": [
      "resize_canvas",
      "change_aspect_ratio",
      "shrink_font",
      "reduce_safe_area",
      "overlap_content",
      "crop_text"
    ],
    "split_when": [
      "content_limit_exceeded",
      "card_body_exceeds_max_lines",
      "icon_and_text_collision",
      "minimum_whitespace_below_24px"
    ],
    "split_naming": {
      "first": "{page}A",
      "second": "{page}B"
    },
    "repeat_on_split": [
      "section_badge",
      "page_marker",
      "title",
      "subtitle",
      "palette",
      "footer_band_style"
    ]
  },
  "generation_rules": {
    "reference_required": true,
    "reference_priority": [
      "layout_and_design_language",
      "palette",
      "typography_hierarchy",
      "icon_style"
    ],
    "exact_text_required": true,
    "invented_content": false,
    "extra_decorations": false,
    "gradients": false,
    "dark_canvas": false,
    "post_validation": {
      "check_dimensions": true,
      "check_aspect_ratio": true,
      "check_text_bounds": true,
      "check_overlap": true,
      "check_forbidden_colors": true,
      "check_required_regions": true
    }
  },
  "export": {
    "width": 1672,
    "height": 941,
    "format": "png",
    "color_space": "sRGB",
    "alpha": false,
    "filename_pattern": "{page_number}_{slug}.png"
  }
